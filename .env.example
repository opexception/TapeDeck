# Tape Backup Script Configuration
# Copy this file to .env and modify values for your environment

# Debug level (0-4)
# 0 = Silent (no output)
# 1 = ERROR only (stderr)
# 2 = ERROR (stderr) + WARNING (stdout)
# 3 = ERROR + WARNING + INFO
# 4 = All levels including DEBUG
DEBUG_LEVEL=3

# Lock file timeout in seconds (how long to wait for a lock to become available)
LOCK_TIMEOUT=60

# Tape device path
TAPE_DEVICE="/dev/st0"

# NFS source to backup (format: server:/export/path)
NFS_SOURCE="10.0.4.25:/xfer"

# Local mount point for NFS share
MOUNT_POINT="/nas/qnap"

# Directory for incremental backup database files (.tardb)
# Must be outside MOUNT_POINT. Keep snapshot history for the whole backup chain.
BACKUP_DB_DIR="/root/backup_db"

# Permanent append-only JSONL catalog. Per-run manifests and file inventories
# are stored beside it. Use separately protected storage outside MOUNT_POINT.
METADATA_FILE="/global/tapeback-metadata/backups.jsonl"

# GNU tar command (on systems with BSD tar, install GNU tar and use "gtar")
TAR_COMMAND="tar"

# Shared tape lock. All invocations using the same drive should use this path.
LOCK_FILE="/tmp/tapeBackup.lock"

# Enable lock file mechanism (true/false)
# Prevents concurrent access to the tape; snapshot state is always locked
ENABLE_LOCKING=false

# Require root privileges (true/false)
# Script will exit with error if not running as root when enabled
ENABLE_ROOT_CHECK=false
